# Copia este archivo como .env.local y completa los valores.

# URL pública del sitio (se usa para los QR de las mesas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Dashboard → Project Settings → API Keys.
SUPABASE_URL=https://bdxvzecjhdvpeyywetek.supabase.co
# Secret key (sb_secret_...). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Firma de cookies (mínimo 32 caracteres aleatorios).
COOKIE_SECRET=
# Contraseña del panel /admin (mínimo 12 caracteres).
ADMIN_PASSWORD=
# Sal para anonimizar IPs (mínimo 16 caracteres aleatorios).
IP_HASH_SALT=
